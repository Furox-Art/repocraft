"""Tests for factorial."""

from __future__ import annotations

import unittest

import factorial


class FactorialTests(unittest.TestCase):
    def test_multiplies_the_numbers_up_to_n(self) -> None:
        self.assertEqual(factorial.factorial(5), 120)

    def test_treats_zero_as_one(self) -> None:
        self.assertEqual(factorial.factorial(0), 1)

    def test_rejects_negative_numbers(self) -> None:
        with self.assertRaises(ValueError):
            factorial.factorial(-1)


if __name__ == "__main__":
    unittest.main()
